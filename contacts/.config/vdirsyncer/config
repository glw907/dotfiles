[general]
status_path = "~/.vdirsyncer/status/"

[pair fastmail_contacts]
a = "contacts_local"
b = "contacts_remote"
collections = ["from a", "from b"]

[storage contacts_local]
type = "filesystem"
path = "~/.contacts/"
fileext = ".vcf"

[storage contacts_remote]
type = "carddav"
url = "https://carddav.fastmail.com/"
username = "geoff@907.life"
password.fetch = ["command", "fastmail-dav-password"]
