# Staged copy of /etc/yum.repos.d/1password.repo, installed by bootstrap.sh's
# layer phase after the signing key's fingerprint is verified.
[1password]
name=1Password Stable Channel
baseurl=https://downloads.1password.com/linux/rpm/stable/$basearch
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-1password
