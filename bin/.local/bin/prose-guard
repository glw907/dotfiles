#!/usr/bin/env python3
"""prose-guard: flag AI-flavored-writing tells in docs, code comments, and content.

Three modes:
  prose-guard --hook       PreToolUse guard. Reads the tool-call JSON on stdin,
                           classifies the target file, scans the content being
                           written, and on a hit prints a JSON deny decision and
                           exits 0. Clean files print nothing. Any internal error
                           also exits 0: a hook bug must never block real work.
  prose-guard --post-hook  PostToolUse feedback. Reads the tool-call JSON on
                           stdin, re-reads the just-written file from disk, runs
                           the advisory layers only, and prints the findings as
                           additionalContext. Never blocks; fails open.
  prose-guard PATHS...     Sweep mode. Scans whole files (every layer, including
  prose-guard --all        statistics), prints a grouped report, exits 1 on a hit.

Three tiers, chosen by path: general (marketing), docs (technical), comments
(code, Pygments comment text only). The hook blocks on lexical + structural
tells. The softer line-level tells (passive phrasing, soft marketing words,
throat-clearing openers, tricolons, emoji), the statistics, and the multi-
sentence patterns are sweep-only advisory and never block a write.
"""
import json
import os
import re
import statistics
import sys

EM_DASH = "—"  # The en dash (ranges) is never flagged.
SENTENCE_SPLIT = re.compile(r"(?<=[.!?])\s+")

CODE_EXTS = {
    ".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs", ".svelte",
    ".py", ".go", ".sh", ".bash", ".rs", ".java", ".c", ".h", ".cpp", ".css", ".scss",
}

BANNED_PHRASES = [
    "it's worth noting", "when it comes to", "dive into", "delve", "let's explore",
    "at the end of the day", "game-changer", "game changer", "state-of-the-art",
    "look no further", "in today's world",
    "to be honest", "to be frank", "the honest answer is", "in the realm of",
    "in the world of",
]
BANNED_OPENERS = [
    "moreover", "additionally", "furthermore", "in conclusion",
    "needless to say", "certainly", "it should be noted",
]
FILLER_WORDS = ["genuinely", "honestly"]
SLOP_WORDS = ["tapestry", "multifaceted", "testament", "seamless"]
# Marketing verbs and vague-quantity words with no exact technical sense. Blocked in every
# tier, because they read as a tell wherever they land.
MARKETING_WORDS = [
    "empower", "streamline", "supercharge", "turbocharge", "revolutionize",
    "effortless", "effortlessly", "plethora", "myriad",
]
JUDGMENT_WORDS = [
    "robust", "leverage", "comprehensive", "dedicated", "curated", "tailored",
    "foster", "elevate", "transformative", "pivotal", "thriving", "meticulous", "nuanced",
    "embark", "harness", "bolster", "groundbreaking", "cutting-edge", "innovative",
    "foundational",
]

# Advisory tells: surfaced in the sweep, never blocked at write time. Active voice is the
# standard, so passive phrasing and the softer marketing words advise rather than block.
ADVISORY_OPENERS = [
    "importantly", "notably", "of course", "ultimately", "overall", "in essence",
    "at its core",
]
ADVISORY_PHRASES = [
    "allows you to", "enables you to", "makes it easy to", "a wide range of",
    "a variety of", "vast array",
]
ADVISORY_WORDS = ["leverage", "unlock", "elevate", "foster", "boost",
                  "vital", "crucial", "essential", "dynamic", "journey", "passion"]
# Fable-era tells (2026-06-09): habits observed in Fable 5 drafts. Advisory until the
# calibration pass vets any of them for the blocking tier. The "worth ..." entries are
# near-dodges of the banned "it's worth noting".
FABLE_PHRASES = [
    "worth noticing", "worth a glance", "worth taking seriously",
    "high-leverage", "highest-leverage",
]
# (regex, kind, hint) advisory patterns for Fable habits with more shape than a substring.
FABLE_PATTERNS = [
    (re.compile(r"(?i)\bthe (honest|real|true) \w+ is\b"),
     "definitional pivot: the honest/real X is",
     "Dramatized pivot that stages the point. State it plainly instead."),
]
PASSIVE_AGENT = re.compile(
    r"(?i)\b(?:is|are|was|were|been|being|be)\s+"
    r"(?:\w+ed|\w+en|built|sent|made|kept|held|run|read|set|done|found|paid|told|drawn|known)"
    r"\b\s+by\b")
# Lowercase-only so a capitalized entity list (Posts, Pages, and Fragments) does not match.
ADJ_TRICOLON = re.compile(r"\b([a-z]{3,}),\s+([a-z]{3,}),?\s+and\s+([a-z]{3,})\s*[.!?]")
SPACED_HYPHEN = re.compile(r"(?i)[a-z]\s-\s[a-z]")
EMOJI = re.compile(
    "[\U0001F300-\U0001FAFF☀-⛿✀-➿⬀-⯿️]")

# Per-tier word lists. comments tier has none beyond the shared rules above.
TIER_WORDS = {
    "general":  SLOP_WORDS + JUDGMENT_WORDS,
    "docs":     SLOP_WORDS,
    "comments": [],
}

# (kind, compiled regex, hint). High-precision; run in every tier.
STRUCTURAL = [
    ("negative antithesis",
     re.compile(r"(?i)\b(it|this|that)'?s?\s+(not|isn'?t)\b[^.!?;]{3,60}[,;]\s+(it|this|that|but)'?s?\b"),
     "Explicit 'not X, it's Y' antithesis. Prefer an implicit contrast or a plain statement."),
    ("not just … but",
     re.compile(r"(?i)\bnot\s+just\b[^.!?]{5,60}\bbut\s+(also\s+)?"),
     "The escalation frame reads as AI. State the point directly."),
    ("setup-colon payoff",
     re.compile(r"(?i)\b(the\s+)?(point|takeaway|truth|reality|bottom line|catch|kicker)\s*:\s+[A-Z]"),
     "The 'The point:' setup-payoff is a tell. Fold it into the sentence."),
    ("copula dodge (serves/stands as)",
     re.compile(r"(?i)\b(serves?|stands?|acts?|functions?)\s+as\s+a\b"),
     "Use 'is' instead of 'serves as a'."),
    ("participial wind-up",
     re.compile(r"(?im)^\s*(building on|recognizing|leveraging|drawing on|having established|taking)\b[^,]{0,40},\s"),
     "Start with the subject, not a participial bridge."),
    ("bold-header bullet",
     re.compile(r"(?im)^\s*[-*]\s+\*\*[^*]+\*\*\s*[:—-]\s+"
                r"(it|this|that|these|those|they|we|you|our|your|its|a|an|the)\b"),
     "The '**Bolded**:' fake-heading bullet (the value continues as a sentence) is the "
     "AI list default. Write a plain bullet. A terse key-value definition list is fine."),
]


def classify(path):
    """Return the tier for a path, or None to skip it."""
    p = path.replace("\\", "/")
    if p.endswith(".md"):
        return "general" if "/src/content/" in p else "docs"
    dot = p.rfind(".")
    if dot != -1 and p[dot:].lower() in CODE_EXTS:
        return "comments"
    return None


def _strip_frontmatter(text):
    """Drop a leading YAML frontmatter block so field values are not scanned."""
    if text.lstrip().startswith("---"):
        parts = text.split("---", 2)
        if len(parts) == 3:
            return parts[2]
    return text


INLINE_CODE = re.compile(r"`[^`]*`")


def _scannable_lines(text):
    """Yield prose lines, with code removed so a sample never reads as a tell.

    Skips fenced code (``` and ~~~), four-space indented code blocks, frontmatter, blank
    lines, and PLACEHOLDER notes, and strips inline `code` spans from each yielded line.
    """
    fence = None  # the marker that opened the open fence, ``` or ~~~
    for line in _strip_frontmatter(text).split("\n"):
        s = line.strip()
        if fence is None and (s.startswith("```") or s.startswith("~~~")):
            fence = s[:3]
            continue
        if fence is not None:
            if s.startswith(fence):
                fence = None
            continue
        if line[:4] == "    " or line[:1] == "\t":  # indented code block
            continue
        if not s or "PLACEHOLDER" in s:
            continue
        yield INLINE_CODE.sub(" ", s)


def scan(text, tier):
    """Lexical + structural tells (the blocking layer). Returns [(kind, snippet, hint)]."""
    issues = []
    for line in _scannable_lines(text):
        if tier in ("docs", "comments"):
            # Humans rarely use em dashes in technical writing, so any one is a tell.
            if EM_DASH in line:
                issues.append(("em dash", line,
                               "Humans rarely use em dashes in technical writing. Rewrite to remove it: "
                               "a period, comma, or parentheses, or recast the sentence."))
        else:
            # General/marketing prose: an occasional em dash is human; flag overuse.
            if line.count(EM_DASH) > 2:
                issues.append(("em-dash spray", line, "Keep at most one interruption (a pair) per line."))
            for sent in SENTENCE_SPLIT.split(line):
                if sent.count(EM_DASH) == 1:
                    after = sent.split(EM_DASH, 1)[1]
                    after = re.sub(r"[*_`)\]]+$", "", after).strip().rstrip(".!?").strip()
                    if 1 <= len(after.split()) <= 6:
                        issues.append(("em-dash appendage", sent.strip(),
                                       "A clause + tacked-on fragment after a dash is a tell. Use a period, comma, or colon."))
        low = line.lower()
        if "not only" in low and "but also" in low:
            issues.append(("not only … but also", line, "Reword without the correlative pair."))
        for phrase in BANNED_PHRASES:
            if phrase in low:
                issues.append((f"banned phrase: {phrase}", line, "Reword in a human voice."))
        for filler in FILLER_WORDS:
            if re.search(rf"\b{filler}\b", low):
                issues.append((f"filler word: {filler}", line, "Drop the filler intensifier."))
        for word in MARKETING_WORDS:
            if re.search(rf"\b{word}\w*\b", low):
                issues.append((f"marketing word: {word}", line, "Cut the marketing verb; say what it does plainly."))
        for opener in BANNED_OPENERS:
            for sent in SENTENCE_SPLIT.split(line):
                head = re.sub(r"^[\s\-*>#]+", "", sent).lower()
                if head.startswith(opener):
                    issues.append((f"banned opener: {opener}", sent.strip(), "Start with a subject, not a connector."))
        for word in TIER_WORDS[tier]:
            if re.search(rf"\b{re.escape(word)}\w*\b", low):
                issues.append((f"banned word: {word}", line, "Reword in a human voice."))
        for kind, rx, hint in STRUCTURAL:
            if rx.search(line):
                issues.append((kind, line, hint))
    return issues


def scan_advisory(text, tier):
    """Softer line-level tells. Sweep-only; the hook never runs these, so none block a write.

    Active voice is the standard, so passive phrasing and the softer marketing words advise
    a rewrite rather than forcing one. The comments tier only gets the spaced-hyphen dodge.
    """
    issues = []
    for line in _scannable_lines(text):
        if SPACED_HYPHEN.search(line):
            issues.append(("advisory: spaced-hyphen dash", line,
                           "A spaced hyphen reads as an em-dash dodge. Recast the sentence."))
        if tier == "comments":
            continue
        low = line.lower()
        for phrase in ADVISORY_PHRASES:
            if phrase in low:
                issues.append((f"advisory: passive phrasing: {phrase}", line,
                               "Prefer active voice. Keep passive only where it truly fits."))
        for word in ADVISORY_WORDS:
            if re.search(rf"\b{word}\w*\b", low):
                issues.append((f"advisory: soft tell: {word}", line, "Consider a plainer word."))
        for phrase in FABLE_PHRASES:
            if phrase in low:
                issues.append((f"advisory: fable tell: {phrase}", line,
                               "A Fable-draft habit. Reword plainly."))
        for rx, kind, hint in FABLE_PATTERNS:
            if rx.search(line):
                issues.append((f"advisory: fable tell: {kind}", line, hint))
        for opener in ADVISORY_OPENERS:
            for sent in SENTENCE_SPLIT.split(line):
                head = re.sub(r"^[\s\-*>#]+", "", sent).lower()
                if head.startswith(opener):
                    issues.append((f"advisory: opener: {opener}", sent.strip(),
                                   "Throat-clearing opener. State the point directly."))
        if PASSIVE_AGENT.search(line):
            issues.append(("advisory: passive (named agent)", line,
                           "Passive with a named agent. Active is usually clearer."))
        if ADJ_TRICOLON.search(line):
            issues.append(("advisory: tricolon", line,
                           "A three-adjective list can read as AI. Keep the one that earns its place."))
        if EMOJI.search(line):
            issues.append(("advisory: emoji", line, "Drop decorative emoji from technical prose."))
    return issues


def _sentences(text):
    """Flatten scannable prose into sentences for whole-document analysis."""
    joined = " ".join(_scannable_lines(text))
    return [s.strip() for s in SENTENCE_SPLIT.split(joined) if s.strip()]


def analyze_document(text, tier):
    """Advisory whole-document signals (sweep-only). Empty for the comments tier."""
    if tier == "comments":
        return []
    issues = []
    sents = _sentences(text)
    counts = [len(s.split()) for s in sents]
    total_words = sum(counts)
    if len(sents) >= 5 and total_words >= 150:
        mean = statistics.fmean(counts)
        if mean > 0:
            burst = statistics.pstdev(counts) / mean
            if burst < 0.25:
                issues.append(("low burstiness (strong)", f"B={burst:.2f} over {len(sents)} sentences",
                               "Sentences are uniform in length. Vary them: mix short and long."))
            elif burst < 0.40:
                issues.append(("low burstiness", f"B={burst:.2f} over {len(sents)} sentences",
                               "Cadence is flat. Add some short sentences and some long ones."))
    # anaphora: 3+ consecutive sentences opening with the same word.
    # Skip markdown list items, headings, tables, and link/code openers.
    heads = []
    for s in sents:
        toks = s.split()
        if toks and toks[0][0] not in "-*#>|[`" and not toks[0][0].isdigit():
            heads.append(toks[0].lower())
    for i in range(len(heads) - 2):
        if heads[i] == heads[i + 1] == heads[i + 2]:
            issues.append(("anaphora", f"3+ sentences open with '{heads[i]}'",
                           "Vary sentence openings."))
            break
    return issues


def _lexer_for(path):
    from pygments.lexers import get_lexer_for_filename
    from pygments.util import ClassNotFound
    try:
        return get_lexer_for_filename(path)
    except ClassNotFound:
        if path.endswith(".svelte"):
            from pygments.lexers import HtmlLexer
            return HtmlLexer()  # <!-- --> plus embedded <script>/<style>
        return None


def extract_comments(path, text):
    """Return only comment-token text from a code file (never identifiers/strings)."""
    try:
        from pygments.token import Comment
        lexer = _lexer_for(path)
        if lexer is None:
            return ""
        return "".join(val for tok, val in lexer.get_tokens(text) if tok in Comment)
    except Exception:
        return ""


def report(issues, path, tier):
    """Human-readable hit list (sweep stdout)."""
    out = [f"PROSE GUARD ({tier}) — {len(issues)} tell(s) in {path}", ""]
    for kind, snippet, hint in issues:
        snippet = (snippet[:140] + "…") if len(snippet) > 140 else snippet
        out += [f"  [{kind}]  {snippet}", f"      → {hint}"]
    return "\n".join(out) + "\n"


def _reason(issues):
    """One-line reason for the hook deny decision."""
    parts = []
    for kind, snip, _h in issues[:5]:
        short = (snip[:40] + "…") if len(snip) > 40 else snip
        parts.append(f"{kind} ({short})")
    suffix = "" if len(issues) <= 5 else f" (+{len(issues) - 5} more)"
    return "prose-guard: " + "; ".join(parts) + suffix + ". Rewrite and retry."


def _content_being_written(tool_name, tool_input):
    if tool_name == "Write":
        return tool_input.get("content", "")
    if tool_name == "Edit":
        return tool_input.get("new_string", "")
    if tool_name == "MultiEdit":
        return "\n".join(e.get("new_string", "") for e in tool_input.get("edits", []))
    return ""


def _scan_for_hook(path, text):
    """Blocking layer only: lexical + structural. Returns (tier, issues)."""
    tier = classify(path)
    if tier is None:
        return None, []
    if tier == "comments":
        text = extract_comments(path, text)
    return tier, scan(text, tier)


def main_hook():
    data = json.loads(sys.stdin.read())
    ti = data.get("tool_input", {})
    path = ti.get("file_path", "")
    _tier, issues = _scan_for_hook(path, _content_being_written(data.get("tool_name", ""), ti))
    if not issues:
        return 0
    sys.stdout.write(json.dumps({"hookSpecificOutput": {
        "hookEventName": "PreToolUse",
        "permissionDecision": "deny",
        "permissionDecisionReason": _reason(issues),
    }}))
    return 0


def main_post_hook():
    """Advisory feedback after a write: cadence and soft tells, never a block."""
    data = json.loads(sys.stdin.read())
    path = data.get("tool_input", {}).get("file_path", "")
    tier = classify(path)
    if tier is None:
        return 0
    try:
        with open(path, encoding="utf-8") as fh:
            raw = fh.read()
    except (OSError, UnicodeDecodeError):
        return 0
    text = extract_comments(path, raw) if tier == "comments" else raw
    issues = scan_advisory(text, tier) + analyze_document(text, tier)
    if not issues:
        return 0
    note = ("\nAdvisory only; nothing is blocked. Revise now if these sit in prose you "
            "just wrote; leave pre-existing body text alone.")
    sys.stdout.write(json.dumps({"hookSpecificOutput": {
        "hookEventName": "PostToolUse",
        "additionalContext": report(issues, path, tier).rstrip() + note,
    }}))
    return 0


SKIP_DIRS = {".git", "node_modules", "dist", "build", ".svelte-kit", ".wrangler", "__pycache__", ".venv"}


def _walk(root="."):
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [d for d in dirnames if d not in SKIP_DIRS]
        for name in filenames:
            yield os.path.join(dirpath, name)


def main_sweep(args):
    paths = list(_walk(".")) if args == ["--all"] else args
    any_hit = False
    for path in paths:
        tier = classify(path)
        if tier is None:
            continue
        try:
            with open(path, encoding="utf-8") as fh:
                raw = fh.read()
        except (OSError, UnicodeDecodeError) as exc:
            sys.stderr.write(f"skip {path}: {exc}\n")
            continue
        text = extract_comments(path, raw) if tier == "comments" else raw
        issues = scan(text, tier) + scan_advisory(text, tier) + analyze_document(text, tier)
        if issues:
            any_hit = True
            sys.stdout.write(report(issues, path, tier))
    return 1 if any_hit else 0


def main():
    args = sys.argv[1:]
    if args and args[0] == "--hook":
        return main_hook()
    if args and args[0] == "--post-hook":
        return main_post_hook()
    return main_sweep(args)


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] in ("--hook", "--post-hook"):
        try:
            sys.exit(main())
        except Exception:
            sys.exit(0)  # fail open
    else:
        sys.exit(main())
