#!/usr/bin/env bash
set -euo pipefail

# Retrieves sudo password from 1Password and caches it for the Claude CLI session.
# Run this once at the start of a CLI mode (cld) session.
#
# Prerequisites:
#   - 1Password desktop app running with CLI integration enabled
#   - eval $(op signin) must have been run in the terminal (or app integration active)
#
# Usage: claude-sudo-setup

PASSWORD=$(op read "op://Private/Workstation sudo/password" 2>/dev/null)

if [ -z "$PASSWORD" ]; then
    echo "Error: Could not read sudo password from 1Password." >&2
    echo "Make sure 1Password is unlocked and CLI integration is enabled." >&2
    exit 1
fi

echo "$PASSWORD" > ~/.cache/claude-sudo-token
chmod 600 ~/.cache/claude-sudo-token
echo "Sudo password cached from 1Password."
