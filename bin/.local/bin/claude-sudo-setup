#!/usr/bin/env bash
set -euo pipefail

# Retrieves the sudo password from 1Password and caches it for the Claude
# session in tmpfs. The cache lives in /dev/shm so it never touches persistent
# disk and vanishes on reboot; claude-sudo-clear shreds it on session exit.
#
# Prerequisites:
#   - 1Password desktop app running with CLI integration enabled
#
# Usage: claude-sudo-setup

CACHE="/dev/shm/claude-sudo-$(id -u)"

PASSWORD=$(op read "op://Private/Workstation sudo/password" 2>/dev/null)

if [ -z "$PASSWORD" ]; then
    echo "Error: Could not read sudo password from 1Password." >&2
    echo "Make sure 1Password is unlocked and CLI integration is enabled." >&2
    exit 1
fi

umask 077
printf '%s\n' "$PASSWORD" > "$CACHE"
echo "Sudo password cached in tmpfs from 1Password."
