#!/usr/bin/env python3
"""PreToolUse hook giving 1Password CLI calls sudo-like session semantics.

An op call can fire a desktop approval popup at Geoff. The first call in a
Claude session IS the authentication: the popup fires once, Geoff approves,
and later calls in the same session ride that approval, the same way sudo
holds a grant after one password. What this hook forbids is the popup loop:
many op calls in quick succession, each one a prompt against Geoff's
attention, which is what the original blanket deny (2026-07-19) was built
to stop. The blanket deny removed the capability instead of the loop and
was repaired to these semantics on Geoff's instruction (2026-08-16).

Policy: allow op calls, but deny when the same session has already made 3+
op calls in the last 60 seconds (a loop signature, never a legitimate
batch: the standing rule is to fetch once and parse locally).
"""

import json
import re
import sys
import time
from pathlib import Path

data = json.load(sys.stdin)
cmd = (data.get("tool_input") or {}).get("command", "")
op_call = re.compile(
    r"(?:^|[\s;&|(`])op\s+"
    r"(?:item|read|inject|run|signin|signout|vault|document"
    r"|user|group|account|whoami|connect|plugin)\b"
)
if not op_call.search(cmd):
    sys.exit(0)

session = str(data.get("session_id") or "unknown")
state_dir = Path.home() / ".cache" / "claude-op-sessions"
state_dir.mkdir(parents=True, exist_ok=True)

# Best-effort prune of state from long-dead sessions.
now = time.time()
for old in state_dir.glob("*.log"):
    try:
        if now - old.stat().st_mtime > 86400:
            old.unlink()
    except OSError:
        pass

state = state_dir / f"{re.sub(r'[^A-Za-z0-9_-]', '_', session)}.log"
try:
    calls = [float(x) for x in state.read_text().split()]
except (OSError, ValueError):
    calls = []

recent = [t for t in calls if now - t < 60]
if len(recent) >= 3:
    reason = (
        "1Password call denied: this session has made 3+ op calls in the "
        "last minute, which is a popup loop, not a batch. Fetch once and "
        "parse locally (`op item get <id> --format json`, or `op item "
        "list --format json` for several items), or use what is already "
        "provisioned in ~/.local/secrets. A repeated prompt is a defect "
        "against Geoff's attention. Wait out the minute only if a second "
        "fetch is genuinely unavoidable."
    )
    print(json.dumps({
        "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "deny",
            "permissionDecisionReason": reason,
        }
    }))
    sys.exit(0)

try:
    state.write_text(" ".join(str(t) for t in recent + [now]))
except OSError:
    pass
sys.exit(0)
