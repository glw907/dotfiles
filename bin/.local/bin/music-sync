#!/usr/bin/env bash
# Push the master music library (~/Music) to its two replicas: the R2
# backup bucket and the Navidrome pod on PikaPods. One-way sync, laptop
# is master. Run after each `beet import` session.
#
# Credentials come from the age store via ~/.local/secrets:
#   MUSIC_R2_ACCESS_KEY_ID / MUSIC_R2_SECRET_ACCESS_KEY
#     from an R2 API token scoped to the music-library bucket
#   MUSIC_POD_SFTP_HOST / MUSIC_POD_SFTP_USER / MUSIC_POD_SFTP_PASSWORD
#     from the PikaPods pod's SFTP settings
# A replica whose credentials are absent is skipped with a notice, so
# the script works before the pod exists.
set -euo pipefail

LIBRARY="$HOME/Music"
SECRETS="$HOME/.local/secrets"
R2_ACCOUNT_ID="120c269ad6d3dfbe6d63a0bb53758ca0"
R2_BUCKET="music-library"
POD_MUSIC_DIR="/music"

if [ -f "$SECRETS" ]; then
    source "$SECRETS"
fi

if [ ! -d "$LIBRARY" ] || [ -z "$(ls -A "$LIBRARY")" ]; then
    echo "music-sync: $LIBRARY is missing or empty; nothing to push." >&2
    exit 1
fi

synced=0

# Both remotes are defined inline through RCLONE_CONFIG_* variables rather
# than rclone.conf, so no credential is ever written to disk.
if [ -n "${MUSIC_R2_ACCESS_KEY_ID:-}" ] && [ -n "${MUSIC_R2_SECRET_ACCESS_KEY:-}" ]; then
    echo "music-sync: pushing to R2 bucket $R2_BUCKET..."
    RCLONE_CONFIG_MUSICR2_TYPE=s3 \
    RCLONE_CONFIG_MUSICR2_PROVIDER=Cloudflare \
    RCLONE_CONFIG_MUSICR2_ENDPOINT="https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com" \
    RCLONE_CONFIG_MUSICR2_ACCESS_KEY_ID="$MUSIC_R2_ACCESS_KEY_ID" \
    RCLONE_CONFIG_MUSICR2_SECRET_ACCESS_KEY="$MUSIC_R2_SECRET_ACCESS_KEY" \
        rclone sync "$LIBRARY" "musicr2:$R2_BUCKET" --fast-list --progress
    synced=$((synced + 1))
else
    echo "music-sync: R2 credentials not set; skipping backup replica." >&2
fi

if [ -n "${MUSIC_POD_SFTP_HOST:-}" ] &&
   [ -n "${MUSIC_POD_SFTP_USER:-}" ] &&
   [ -n "${MUSIC_POD_SFTP_PASSWORD:-}" ]; then
    echo "music-sync: pushing to Navidrome pod ${MUSIC_POD_SFTP_HOST}..."
    # The sftp backend reads its password only in rclone's obscured form.
    RCLONE_CONFIG_MUSICPOD_TYPE=sftp \
    RCLONE_CONFIG_MUSICPOD_HOST="$MUSIC_POD_SFTP_HOST" \
    RCLONE_CONFIG_MUSICPOD_USER="$MUSIC_POD_SFTP_USER" \
    RCLONE_CONFIG_MUSICPOD_PASS="$(rclone obscure "$MUSIC_POD_SFTP_PASSWORD")" \
        rclone sync "$LIBRARY" "musicpod:$POD_MUSIC_DIR" --progress
    synced=$((synced + 1))
else
    echo "music-sync: pod SFTP credentials not set; skipping streaming replica." >&2
fi

if [ "$synced" -eq 0 ]; then
    echo "music-sync: no replica credentials configured; nothing synced." >&2
    exit 1
fi
echo "music-sync: done ($synced replica(s))."
