#!/usr/bin/env bash
set -euo pipefail

# Update Go toolchain at /usr/local/go to the latest stable release.
# Usage: update-go [--allow-minor] [--dry-run]
#
# Auto-applies same-series patch bumps (e.g. 1.26.1 → 1.26.3).
# A minor bump (e.g. 1.26.x → 1.27.0) requires --allow-minor — exits
# nonzero otherwise so cron / workstation-update halts loudly.
#
# Authoritative version + checksums come from https://go.dev/dl/?mode=json.

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

ALLOW_MINOR=false
DRY_RUN=false
for arg in "$@"; do
    case "$arg" in
        --allow-minor) ALLOW_MINOR=true ;;
        --dry-run)     DRY_RUN=true ;;
        -h|--help)
            sed -n '3,9p' "$0" | sed 's/^# //; s/^#//'
            exit 0
            ;;
        *) echo -e "${RED}unknown arg: $arg${NC}" >&2; exit 2 ;;
    esac
done

GOROOT=/usr/local/go
if [[ ! -x "$GOROOT/bin/go" ]]; then
    echo -e "${RED}ERROR: go not found at $GOROOT/bin/go${NC}" >&2
    exit 1
fi

CURRENT=$("$GOROOT/bin/go" env GOVERSION)   # e.g. go1.26.1
LATEST=$(curl -fsSL 'https://go.dev/dl/?mode=json' \
    | python3 -c 'import json,sys; print(json.load(sys.stdin)[0]["version"])')

echo "Current: $CURRENT"
echo "Latest:  $LATEST"

if [[ "$CURRENT" == "$LATEST" ]]; then
    echo -e "${GREEN}✓ Already up to date${NC}"
    exit 0
fi

# Parse MAJOR.MINOR for the gate. "go1.26.1" → "1.26".
series() { sed -E 's/^go([0-9]+\.[0-9]+).*/\1/' <<<"$1"; }
CUR_SERIES=$(series "$CURRENT")
NEW_SERIES=$(series "$LATEST")

if [[ "$CUR_SERIES" != "$NEW_SERIES" ]]; then
    echo -e "${YELLOW}⚠ minor-series bump: $CUR_SERIES → $NEW_SERIES${NC}"
    if [[ "$ALLOW_MINOR" != true ]]; then
        echo "  Refusing without --allow-minor."
        echo "  Review release notes (https://go.dev/doc/devel/release), then re-run:"
        echo "    update-go --allow-minor"
        exit 3
    fi
fi

ARCH=$(dpkg --print-architecture 2>/dev/null || uname -m)
case "$ARCH" in
    amd64|x86_64) GOARCH=amd64 ;;
    arm64|aarch64) GOARCH=arm64 ;;
    *) echo -e "${RED}unsupported arch: $ARCH${NC}" >&2; exit 1 ;;
esac

FILE="${LATEST}.linux-${GOARCH}.tar.gz"
SHA=$(curl -fsSL 'https://go.dev/dl/?mode=json' \
    | python3 -c "import json,sys; d=json.load(sys.stdin)[0];
[print(f['sha256']) for f in d['files'] if f['filename']=='$FILE']")
if [[ -z "$SHA" ]]; then
    echo -e "${RED}no manifest entry for $FILE${NC}" >&2
    exit 1
fi

if [[ "$DRY_RUN" == true ]]; then
    echo "Would download https://go.dev/dl/$FILE (sha256 $SHA)"
    echo "Would replace $GOROOT"
    exit 0
fi

TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT
echo "Downloading $FILE..."
curl -fsSL -o "$TMP/$FILE" "https://go.dev/dl/$FILE"
echo "$SHA  $TMP/$FILE" | sha256sum -c -

sudo -A rm -rf "$GOROOT"
sudo -A tar -C /usr/local -xzf "$TMP/$FILE"

AFTER=$("$GOROOT/bin/go" env GOVERSION)
echo -e "${GREEN}✓ Updated: $CURRENT → $AFTER${NC}"

# Poplar toolchain-pin reminder (manual bump per workstation policy).
POPLAR_MOD="$HOME/Projects/poplar/go.mod"
if [[ -f "$POPLAR_MOD" ]]; then
    PINNED=$(awk '/^toolchain /{print $2}' "$POPLAR_MOD")
    if [[ -n "$PINNED" && "$PINNED" != "$AFTER" ]]; then
        echo -e "${YELLOW}↪ poplar go.mod pins toolchain $PINNED — bump to $AFTER in a deliberate commit${NC}"
    fi
fi
