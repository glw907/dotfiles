#!/usr/bin/env python3
"""Deny Claude Code tool calls that would write secret-shaped material.

PreToolUse hook for Write, Edit, and Bash. Reads the hook payload from stdin,
scans the text that would land on disk (file content, edit replacement, or a
git commit command's tree) for credential shapes, and exits 2 with a reason to
block the call. Born from the 2026-01-30 incident where a live Cloudflare API
token was committed to the public workstation repo in plaintext.

Set CLAUDE_SECRET_GUARD_ALLOW=1 in the command environment to bypass one
deliberate write of a known-fake value (test fixtures, documentation examples).
"""

import json
import os
import re
import sys

PATTERNS = [
    (r"sk-ant-[A-Za-z0-9_-]{20,}", "Anthropic API key"),
    (r"\bsk-[A-Za-z0-9]{32,}", "provider API key (sk-...)"),
    (r"\bgh[pousr]_[A-Za-z0-9]{36,}", "GitHub token"),
    (r"\bgithub_pat_[A-Za-z0-9_]{36,}", "GitHub fine-grained PAT"),
    (r"\bxox[baprs]-[A-Za-z0-9-]{10,}", "Slack token"),
    (r"\bAKIA[0-9A-Z]{16}\b", "AWS access key id"),
    (r"AGE-SECRET-KEY-1[A-Z0-9]{20,}", "age private key"),
    (r"-----BEGIN [A-Z ]*PRIVATE KEY-----", "PEM private key"),
    (r"\beyJ[A-Za-z0-9_-]{20,}\.eyJ[A-Za-z0-9_-]{20,}", "JWT"),
    (
        r"(?i)^\s*(export\s+)?[A-Z0-9_]*(TOKEN|SECRET|PASSWORD|PASSWD|API_KEY|"
        r"PRIVATE_KEY|CLIENT_SECRET)[A-Z0-9_]*\s*=\s*['\"]?[A-Za-z0-9+/_.=-]{16,}",
        "credential-shaped assignment with a literal value",
    ),
]

# A line matching one of these is a reference or placeholder, not a value.
# "secret-guard-allow" is the inline bypass: put it on the same line as a
# known-fake value (a test fixture, a docs example) to write it deliberately.
ALLOW = re.compile(
    r"redacted|placeholder|<value|\$\{?[A-Za-z_]|op://|1x0{20}|"
    r"changeme|your[-_]?token|xxxx|secret-guard-allow",
    re.IGNORECASE,
)


def scan(text):
    """Return (pattern name, offending line) for the first hit, else None."""
    for line in text.splitlines():
        if ALLOW.search(line):
            continue
        for pattern, name in PATTERNS:
            if re.search(pattern, line, re.MULTILINE):
                return name, line[:80]
    return None


def gather_text(payload):
    """Extract the text a tool call would persist, from the hook payload."""
    tool = payload.get("tool_name", "")
    inp = payload.get("tool_input", {})
    if tool == "Write":
        return inp.get("content", "")
    if tool == "Edit":
        return inp.get("new_string", "")
    if tool == "Bash":
        cmd = inp.get("command", "")
        # Only commit-shaped commands are scanned, plus the command line
        # itself (a token pasted into any command is already a leak).
        return cmd
    return ""


def main():
    """Read the hook payload, scan it, and exit 2 on a hit."""
    if os.environ.get("CLAUDE_SECRET_GUARD_ALLOW") == "1":
        return 0
    try:
        payload = json.load(sys.stdin)
    except (json.JSONDecodeError, ValueError):
        return 0  # fail open on malformed payload; gitleaks backstops commits
    text = gather_text(payload)
    if not text:
        return 0
    hit = scan(text)
    if hit:
        name, line = hit
        sys.stderr.write(
            "claude-secret-guard: blocked, {} detected in tool input "
            "(line starts: {!r}). Secrets belong in the age store via "
            "secret-set.sh, never in tracked files. For a known-fake value, "
            "add 'secret-guard-allow' on that line (or set "
            "CLAUDE_SECRET_GUARD_ALLOW=1 in the session).\n".format(name, line)
        )
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
