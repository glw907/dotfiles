#!/usr/bin/env bash
# claude-wf-guard: the runaway guard for a Claude Code Workflow run.
#
# This exists because the guard's calibration has been got wrong three times (2026-07-28,
# 2026-08-13, 2026-08-14), each time by hand-writing thresholds from the oldest numbers in the
# workflow-agent-runaway-guard memory instead of the measured ones further down it. A rule that
# has failed three times belongs in a tool, so arm a guard by running this and naming a tier,
# never by writing thresholds again.
#
# Usage:
#   claude-wf-guard <transcript-dir> <tier> [run-id]
#
# Tiers, each measured on a real run rather than guessed:
#   implementer  1.8MB   a cairn-implementer clearing the full gate (npm test alone is ~150s)
#   writer       4MB     a documentation producer; six sat at 0.8-1.1MB while healthy
#   build        5MB     build and e2e agents, verbose tool output
#   visual      24MB     screenshot-comparing agents; renders embed base64 at MBs each
#
# LIVENESS is the primary signal and journal idle is deliberately not used. journal.jsonl only
# writes when an agent completes, so a serial workflow, or a parallel one with long steps, has
# journal gaps by design and a journal-idle alarm fires on healthy work.
#
# The idle alarm also fires on a CLEAN FINISH, since the transcript directory persists after the
# run. Kill this guard from the main loop when the workflow's completion notification arrives.
set -u

DIR=${1:-}
TIER=${2:-writer}
RUN_ID=${3:-}

if [ -z "$DIR" ] || [ ! -d "$DIR" ]; then
  echo "claude-wf-guard: usage: claude-wf-guard <transcript-dir> <tier> [run-id]" >&2
  echo "  tiers: implementer | writer | build | visual" >&2
  exit 64
fi

case "$TIER" in
  implementer) SIZE_LIMIT=1887437 ;;
  writer)      SIZE_LIMIT=4194304 ;;
  build)       SIZE_LIMIT=5242880 ;;
  visual)      SIZE_LIMIT=25165824 ;;
  *) echo "claude-wf-guard: unknown tier '$TIER'" >&2; exit 64 ;;
esac

IDLE_SECONDS=600
INTERVAL=300
RESUME_HINT="Relaunch with resumeFromRunId ${RUN_ID:-<run-id>}; completed agents replay from cache."

declare -A LAST_SIZE
declare -A GROWTH_STREAK

echo "claude-wf-guard: watching $DIR (tier $TIER, size limit $SIZE_LIMIT, idle ${IDLE_SECONDS}s)"

while true; do
  sleep "$INTERVAL"

  newest=$(ls -t "$DIR"/agent-*.jsonl 2>/dev/null | head -1)
  if [ -n "$newest" ]; then
    age=$(( $(date +%s) - $(stat -c %Y "$newest") ))
    if [ "$age" -gt "$IDLE_SECONDS" ]; then
      echo "ALARM idle: no agent transcript written in ${age}s (limit ${IDLE_SECONDS}s)."
      echo "A clean finish looks identical. Confirm the workflow is still running before acting."
      echo "$RESUME_HINT"
      exit 2
    fi
  fi

  for f in "$DIR"/agent-*.jsonl; do
    [ -e "$f" ] || continue
    size=$(stat -c %s "$f")
    prev=${LAST_SIZE[$f]:-0}
    LAST_SIZE[$f]=$size
    if [ "$size" -gt "$SIZE_LIMIT" ] && [ "$size" -gt "$prev" ]; then
      GROWTH_STREAK[$f]=$(( ${GROWTH_STREAK[$f]:-0} + 1 ))
      if [ "${GROWTH_STREAK[$f]}" -ge 3 ]; then
        echo "ALARM runaway: $(basename "$f") at ${size} bytes, growing for 3 consecutive checks."
        echo "Confirm by the transcript tail before any TaskStop: varied Read/Edit/Write/Bash"
        echo "interleaving is progress, repeated identical calls are a loop."
        echo "$RESUME_HINT"
        exit 3
      fi
    else
      GROWTH_STREAK[$f]=0
    fi
  done
done
