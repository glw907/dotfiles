#!/usr/bin/env bash
# fastmail-filter: Create Fastmail filter rules from aerc
# Subcommands: extract, save, apply, folders

set -euo pipefail

RULES_FILE="$HOME/.config/aerc/mailrules.json"
TMPDIR="${TMPDIR:-/tmp}"
EXTRACT_FILE="$TMPDIR/fastmail-filter-extract"

cmd_extract() {
    local type="$1"
    local headers
    headers=$(cat)

    local value
    case "$type" in
        from)
            # Extract email address from From header
            local raw
            raw=$(echo "$headers" | grep -i '^From:' | head -1 | sed 's/^[Ff]rom:[[:space:]]*//')
            if echo "$raw" | grep -q '<'; then
                value=$(echo "$raw" | grep -oP '<\K[^>]+')
            else
                value=$(echo "$raw" | tr -d '[:space:]')
            fi
            ;;
        subject)
            value=$(echo "$headers" | grep -i '^Subject:' | head -1 | sed 's/^[Ss]ubject:[[:space:]]*//')
            ;;
        *)
            echo "Unknown extract type: $type" >&2
            exit 1
            ;;
    esac

    echo "$value" > "$EXTRACT_FILE"
}

EXCLUDED_FOLDERS="^(Inbox|Sent|Drafts|Outbox|Trash|Spam|Archive)$"

cmd_folders() {
    if [[ -z "${FASTMAIL_API_TOKEN:-}" ]]; then
        echo "FASTMAIL_API_TOKEN is not set" >&2
        exit 1
    fi

    local session account_id
    session=$(curl -sf -H "Authorization: Bearer $FASTMAIL_API_TOKEN" \
        https://api.fastmail.com/jmap/session)
    account_id=$(echo "$session" | jq -r '.primaryAccounts["urn:ietf:params:jmap:mail"]')

    if [[ -z "$account_id" || "$account_id" == "null" ]]; then
        echo "Failed to get account ID from JMAP session" >&2
        exit 1
    fi

    curl -sf \
        -H "Authorization: Bearer $FASTMAIL_API_TOKEN" \
        -H "Content-Type: application/json" \
        -d "{
            \"using\": [\"urn:ietf:params:jmap:core\", \"urn:ietf:params:jmap:mail\"],
            \"methodCalls\": [[
                \"Mailbox/get\",
                {\"accountId\": \"$account_id\", \"properties\": [\"name\", \"role\"]},
                \"0\"
            ]]
        }" \
        https://api.fastmail.com/jmap/api/ \
    | jq -r '
        .methodResponses[0][1].list[]
        | select(.role == null)
        | .name
    ' | grep -Ev "$EXCLUDED_FOLDERS" | sort
}

case "${1:-}" in
    extract) shift; cmd_extract "$@" ;;
    folders) cmd_folders ;;
    *) echo "Usage: fastmail-filter {extract|save|apply|folders} ..." >&2; exit 1 ;;
esac
