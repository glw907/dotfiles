{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "voiceEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "defaultMode": "bypassPermissions",
  "autoMemoryEnabled": true,
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/gather-dotfiles.sh && echo '' && ~/.claude/gather-scripts.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "notify-send 'Claude Code' 'Needs your attention' --urgency=normal 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
