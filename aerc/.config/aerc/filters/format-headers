#!/usr/bin/awk -f
# format-headers: colorize and reorder email headers for aerc viewer
# Colors matched to nvim-mail aercmail syntax (Nord palette)

BEGIN {
    blue   = "\033[1;38;2;129;161;193m"
    fg     = "\033[38;2;216;222;233m"
    grey   = "\033[38;2;97;110;136m"
    reset  = "\033[0m"

    # Use viewer width from aerc, fall back to 80
    cols = ENVIRON["AERC_COLUMNS"]
    if (cols + 0 < 1) cols = 80

    sep = grey
    for (i = 1; i <= cols; i++) sep = sep "─"
    sep = sep reset
}

{ gsub(/\r/, "") }

/^[ \t]/ {
    if (current != "") headers[current] = headers[current] "\n" $0
    next
}

/^[A-Za-z-]+:/ {
    colon = index($0, ":")
    key = substr($0, 1, colon - 1)
    lkey = tolower(key)
    keys[lkey] = key
    headers[lkey] = substr($0, colon + 1)
    current = lkey
    next
}

function colorize(val) {
    out = ""
    while (match(val, /<[^>]+>/)) {
        out = out fg substr(val, 1, RSTART - 1) grey substr(val, RSTART, RLENGTH)
        val = substr(val, RSTART + RLENGTH)
    }
    return out fg val reset
}

/^$/ {
    split("from to cc bcc date subject", order)

    for (i = 1; i <= 6; i++) {
        k = order[i]
        if (!(k in headers)) continue

        val = headers[k]
        gsub(/\n[ \t]+/, " ", val)
        sub(/^ /, "", val)
        key = keys[k] ":"

        # Address headers: wrap at recipient boundaries
        if (k == "from" || k == "to" || k == "cc" || k == "bcc") {
            # Strip bare <email> (no name before it)
            while (match(val, /^<[^>]+>/) || match(val, /, *<[^>]+>/)) {
                # Only strip if preceded by start or comma (not a name)
                if (substr(val, RSTART, 1) == "<") {
                    email = substr(val, RSTART + 1, RLENGTH - 2)
                    val = email substr(val, RSTART + RLENGTH)
                } else {
                    pre = substr(val, 1, RSTART)
                    rest = substr(val, RSTART + 1)
                    sub(/^ *</, "", rest)
                    match(rest, /[^>]+/)
                    email = substr(rest, RSTART, RLENGTH)
                    after = substr(rest, RSTART + RLENGTH + 1)
                    val = pre " " email after
                }
            }

            # Split recipients by comma
            n = split(val, rcpts, ", *")
            indent_len = length(key) + 1
            indent = ""
            for (p = 1; p <= indent_len; p++) indent = indent " "

            cur = key " " rcpts[1]
            for (j = 2; j <= n; j++) {
                test = cur ", " rcpts[j]
                if (length(test) <= cols) {
                    cur = test
                } else {
                    # Print current line with key colored
                    colon_pos = index(cur, ":")
                    print blue substr(cur, 1, colon_pos) reset colorize(substr(cur, colon_pos + 1)) ","
                    cur = indent rcpts[j]
                }
            }
            # Print last line
            colon_pos = index(cur, ":")
            if (colon_pos > 0 && colon_pos <= length(key) + 1) {
                print blue substr(cur, 1, colon_pos) reset colorize(substr(cur, colon_pos + 1))
            } else {
                print colorize(cur)
            }
        } else {
            # Non-address: single line
            print blue key reset colorize(" " val)
        }
    }

    print sep
}
